ENVIRONMENT=development

# Debe coincidir con NEXT_PUBLIC_API_URL del frontend si lo cambias ahí
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Supabase 
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-de-supabase
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-supabase  # Solo para operaciones admin (ej. borrar usuario)
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase
DATABASE_URL=postgresql+asyncpg://postgres:tu-password@db.tu-proyecto.supabase.co:5432/postgres

#Ai
# --- Opción A: Groq (gratis, recomendado para pruebas) ---
AI_PROVIDER=groq
OPENAI_API_KEY=gsk_tu-api-key-de-groq
OPENAI_MODEL=llama-3.3-70b-versatile
AI_PREMIUM_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=   # déjalo vacío: se resuelve solo desde AI_PROVIDER=groq

# --- Opción B: OpenAI (de pago) ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-tu-api-key-de-openai
# OPENAI_MODEL=gpt-4o
# AI_PREMIUM_MODEL=gpt-4o

LOG_LEVEL=INFO
FREE_MATCH_LIMIT=5
FREE_INTERVIEW_LIMIT=1
