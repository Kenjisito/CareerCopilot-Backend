ENVIRONMENT=development

# Debe coincidir con NEXT_PUBLIC_API_URL del frontend si lo cambias ahí
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Supabase 
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=tu-anon-key-de-supabase
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-NO-la-subas-a-git
# Ya no se usa: el backend valida los tokens con la clave pública (JWKS) de SUPABASE_URL
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres
# Para desarrollo local sin Supabase: sqlite+aiosqlite:///./careercopilot.db
#Ai
# --- Opción A: Groq (gratis, recomendado para pruebas) ---
AI_PROVIDER=groq
OPENAI_API_KEY=gsk_tu-api-key-de-groq
OPENAI_MODEL=llama-3.3-70b-versatile
AI_PREMIUM_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=   # déjalo vacío: se resuelve solo desde AI_PROVIDER=groq

# --- Opción B: OpenAI (de pago) ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-tu-api-key-de-openai
# OPENAI_MODEL=gpt-4o
# AI_PREMIUM_MODEL=gpt-4o

LOG_LEVEL=INFO
FREE_MATCH_LIMIT=5
FREE_INTERVIEW_LIMIT=3

# Límite de uso de IA por usuario y hora
AI_RATE_LIMIT_PER_HOUR=40
AI_RATE_LIMIT_PREMIUM_PER_HOUR=200
# Correos que pueden activar Premium manualmente (POST /api/v1/auth/admin/plan). Formato JSON.
ADMIN_EMAILS=["tu-correo@ejemplo.cl"]
